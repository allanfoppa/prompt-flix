local.file_match "promptflix_logs" {
path_targets = [{
__path__ = "/logs/*.log",
job       = "promptflix",
env       = "development",
}]
}

loki.source.file "promptflix" {
targets    = local.file_match.promptflix_logs.targets
forward_to = [loki.write.default.receiver]
}

loki.write "default" {
endpoint {
url = "http://loki:3100/loki/api/v1/push"
}
}
